# Copiar a .env y ajustar. Si no existe .env, docker-compose usa estos valores.

# Base de datos (PostgreSQL + PostGIS)
POSTGRES_USER=carpooling
POSTGRES_PASSWORD=carpooling_dev
POSTGRES_DB=carpooling
POSTGRES_PORT=5432
DATABASE_URL=postgresql://carpooling:carpooling_dev@localhost:5432/carpooling

# Backend (NestJS)
PORT=3000

# Motor de rutas OSRM (docker compose --profile routing up -d). Si no
# responde, el backend estima la ruta en línea recta
OSRM_PORT=5000
OSRM_URL=http://localhost:5000

# Seguimiento del viaje: segundos mínimos entre dos posiciones del conductor
# (frecuencia de actualización del Gemelo Digital, DP-04)
POSITION_MIN_INTERVAL_SECONDS=10

# Autenticación. JWT_SECRET: mínimo 32 caracteres; este valor es SOLO para
# desarrollo local; en cualquier otro entorno, genera uno aleatorio y secreto
JWT_SECRET=change-me-dev-only-secret-0123456789abcdef
JWT_ACCESS_TTL_MINUTES=15
# Sesión: cada renovación da JWT_REFRESH_TTL_DAYS días más, con un máximo de
# JWT_SESSION_MAX_DAYS días desde el login
JWT_REFRESH_TTL_DAYS=7
JWT_SESSION_MAX_DAYS=30
# Dominios de correo permitidos en el registro (separados por comas)
ALLOWED_EMAIL_DOMAINS=ual.es,inlumine.ual.es
# Documentación interactiva de la API (Swagger UI) en /api/docs
API_DOCS_ENABLED=true

# Envío de correos (códigos de verificación). En desarrollo, el Mailpit de
# docker compose: los correos se ven en http://localhost:8025 y no salen a
# Internet. En producción, un servidor SMTP real (ver docs/despliegue.md).
# MAIL_TRANSPORT: smtp (por defecto) o memory (no envía; lo usan los tests)
MAIL_TRANSPORT=smtp
MAIL_FROM=Carpooling UAL <no-reply@carpooling-ual.local>
SMTP_HOST=localhost
SMTP_PORT=1025
# true solo con conexión cifrada desde el principio (puerto 465)
SMTP_SECURE=false
# Usuario y contraseña del servidor SMTP (Mailpit no los necesita)
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_UI_PORT=8025
